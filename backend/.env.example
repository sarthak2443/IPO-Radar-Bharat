APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipo_radar?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ipo_radar
DB_SSLMODE=disable

# Cache (Redis)
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (Future)
KAFKA_BROKERS=localhost:9092
